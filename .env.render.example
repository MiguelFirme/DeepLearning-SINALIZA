# Configure no painel Environment do Render. Substitua pela origem real, sem / final.
# O valor deve ser um array JSON, não uma lista separada por vírgulas.
SINALIZA_CORS_ORIGINS=["https://SEU-PROJETO.vercel.app"]
# Opcional: regex restrita aos previews do SEU projeto/equipe.
# SINALIZA_CORS_ORIGIN_REGEX=https://SEU-PROJETO-[a-z0-9-]+-SUA-EQUIPE\.vercel\.app
# PORT é fornecida pelo Render; não precisa fixar 8000.
