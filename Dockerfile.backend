FROM python:3.11-slim

WORKDIR /app

# Dependências de sistema para OpenCV headless
RUN apt-get update && \
    apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ml/ ml/
COPY backend/ backend/
COPY configs/ configs/
COPY ["Modelos salvos/transformer_v2_mixed23_full", "/app/Modelos salvos/transformer_v2_mixed23_full"]
COPY ["Modelos salvos/transformer_mixed25_pose_face", "/app/Modelos salvos/transformer_mixed25_pose_face"]
COPY ["Modelos salvos/transformer_mixed25_full", "/app/Modelos salvos/transformer_mixed25_full"]
COPY ["Modelos salvos/conv_bilstm_attention_mixed25_pose_face", "/app/Modelos salvos/conv_bilstm_attention_mixed25_pose_face"]
COPY ["Modelos salvos/conv_bilstm_attention_mixed25_full", "/app/Modelos salvos/conv_bilstm_attention_mixed25_full"]

# Criar diretórios para artefatos
RUN mkdir -p artifacts data

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
